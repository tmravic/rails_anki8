<h1>Login</h1>

<% if flash.now[:alert] %>
  <div style="color: red"><%= flash.now[:alert] %></div>
<% end %>

<% if @user_session.errors.any? %>
  <ul style="color: red">
    <% @user_session.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @user_session, url: user_session_path do |f| %>
  <%= f.label :email_address, "Email Address" %>
  <%= f.text_field :email_address %>

  <%= f.label :password %>
  <%= f.password_field :password %>

  <%= f.label :remember_me %>
  <%= f.check_box :remember_me %>

  <%= f.submit "Login" %>
<% end %>