<% content_for :head do %>
    <script type="text/javascript" charset="utf-8">
          console.log("Only log this in the custom layout")
      </script>
  <% end %>

<%# ========================================================================== %>
<%# MOBILE DETECTION DEBUG (added as part of mobile-fu tutorial)             %>
<%# ========================================================================== %>
<p style="background: #f0f0f0; padding: 8px; border-left: 4px solid #666;">
  <strong>Mobile Detection (mobile-fu):</strong><br>
  <% if is_mobile_device? %>
    📱 <strong>is_mobile_device?</strong> returned truthy<br>
    mobile_device = <%= mobile_device.inspect %><br>
    <small>Try emulating a phone in DevTools and refreshing. Also try adding ?pc_style=1 to the URL.</small>
  <% else %>
    🖥️ Desktop / non-mobile view
  <% end %>
</p>
<%# ========================================================================== %>

<% if current_user %>
  <p>Hello <%= current_user.email_address %>! </p>
  <p>You are a [<%= current_user.role %>]</p>
  <br>
  <% if current_user.admin? %>
      There are <%= User.count %> users
    <% end %>
  <p>
    You have successfully authenticated.
    You are now ready to interact with this application.
  </p>
  <h1>Notification Broadcast Test</h1>

  <%= button_to "Trigger Live Update", live_update_path, method: :post, class: "btn btn-primary" %>

  <h1>Import Job</h1>

  <%= button_to "Import Job", import_path, method: :post, class: "btn btn-primary" %>

  <%= link_to "Sign Out", session_path, 'data-turbo-method': :delete %>
<% else %>
  <p>You are not signed in.</p>
  <%= link_to "Sign up!", new_user_registration_path %>
  <%= link_to "Login", new_user_session_path %>
<% end %>

<div class="box">
  <div>One</div>
  <div>Two</div>
  <div>Three</div>
</div>