<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Anki8" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%#= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag 'application', "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <aside id="turbo-demo">
      <p><strong>Turbo lifecycle demo</strong> — watch the log + browser console</p>

      <table class="turbo-event-table">
        <thead>
          <tr><th>Event</th><th>Count</th><th>Role</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><code>DOMContentLoaded</code></td>
            <td data-event-count="DOMContentLoaded">0</td>
            <td>Full page load only — JS context created once</td>
          </tr>
          <tr>
            <td><code>turbo:before-cache</code></td>
            <td data-event-count="turbo:before-cache">0</td>
            <td>Leaving a page — Turbo snapshots it for back-button restore</td>
          </tr>
          <tr>
            <td><code>turbo:before-render</code></td>
            <td data-event-count="turbo:before-render">0</td>
            <td>New HTML fetched — about to replace &lt;body&gt;</td>
          </tr>
          <tr>
            <td><code>turbo:render</code></td>
            <td data-event-count="turbo:render">0</td>
            <td>New &lt;body&gt; inserted into the DOM</td>
          </tr>
          <tr>
            <td><code>turbo:load</code></td>
            <td data-event-count="turbo:load">0</td>
            <td>Page ready — recolors .box below</td>
          </tr>
          <tr>
            <td><code>turbo:frame-render</code></td>
            <td data-event-count="turbo:frame-render">0</td>
            <td>A &lt;turbo-frame&gt; updated (partial navigation)</td>
          </tr>
        </tbody>
      </table>

      <p><strong>Typical link-click order:</strong>
        <code>before-cache</code> → <code>before-render</code> → <code>render</code> → <code>load</code>
        → <code>frame-render</code> (lazy frame below loads after)
      </p>

      <p><strong>Event log</strong> (newest first):</p>
      <ol id="turbo-event-log" reversed></ol>

      <nav>
        <%= link_to "Home", root_path %> |
        <%= link_to "New card", new_card_path %>
      </nav>
      <div class="box">
        <div>One</div>
        <div>Two</div>
        <div>Three</div>
      </div>

      <h3>Turbo Frame</h3>
      <p>Lazy-loads after each visit; click "Reload frame" for frame-only navigation.</p>
      <%= turbo_frame_tag "demo_frame", src: frame_demo_path, loading: :lazy do %>
        <em>Frame loading…</em>
      <% end %>
    </aside>

    <%= yield %>
  </body>
</html>
