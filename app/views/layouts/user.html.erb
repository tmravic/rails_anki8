<!DOCTYPE html>
<html>
<head>
  <title>Rails Anki8</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <header style="background:#2c3e50; color:white; padding:12px 20px; display:flex; justify-content:space-between; align-items:center;">
    <strong>Rails Anki8</strong>
    <% if current_user %>
      <%= button_to "Sign out", session_path, method: :delete, data: { turbo: false }, style: "background:none; border:none; color:#ddd; font-size:13px; cursor:pointer;" %>
    <% end %>
  </header>

  <div style="max-width: 1100px; margin: 20px auto; padding: 0 20px;">
    <%= yield %>
  </div>
</body>
</html>
